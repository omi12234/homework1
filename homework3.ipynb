    "# ==============================================================================\n",
    "# SECTION 4: CLUSTERING ANALYSIS (ROBUST & ERROR-SAFE)\n",
    "# Models: K-Means, DBSCAN, Hierarchical Clustering (Ward)\n",
    "# Analysis: Sample Clustering, Feature Space Clustering (Transposed), and Variance Metric\n",
    "# ==============================================================================\n",
    "\n",
    "from sklearn.cluster import KMeans, DBSCAN, AgglomerativeClustering\n",
    "from sklearn.metrics import silhouette_score\n",
    "\n",
    "# 1. SAMPLE CLUSTERING\n",
    "# Fit K-Means\n",
    "kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n",
    "labels_kmeans = kmeans.fit_predict(X_scaled)\n",
    "\n",
    "# Fit DBSCAN (Calibrated parameters to capture dense cores)\n",
    "dbscan = DBSCAN(eps=1.8, min_samples=10)\n",
    "labels_dbscan = dbscan.fit_predict(X_scaled)\n",
    "\n",
    "# Fit Hierarchical Clustering (Agglomerative with Ward linkage)\n",
    "hierarchical = AgglomerativeClustering(n_clusters=3, linkage='ward')\n",
    "labels_hierarchical = hierarchical.fit_predict(X_scaled)\n",
    "\n",
    "# Plot sample clustering allocations on 2D PCA plane\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "\n",
    "axes[0].scatter(X_pca_3d[:, 0], X_pca_3d[:, 1], c=labels_kmeans, cmap='tab10', alpha=0.4, s=15)\n",
    "axes[0].set_title('K-Means (K=3)', fontweight='bold')\n",
    "axes[0].set_xlabel('PC1')\n",
    "axes[0].set_ylabel('PC2')\n",
    "\n",
    "axes[1].scatter(X_pca_3d[:, 0], X_pca_3d[:, 1], c=labels_dbscan, cmap='coolwarm', alpha=0.4, s=15)\n",
    "n_noise = np.sum(labels_dbscan == -1)\n",
    "n_clusters_db = len(set(labels_dbscan)) - (1 if -1 in labels_dbscan else 0)\n",
    "axes[1].set_title(f'DBSCAN (Clusters: {n_clusters_db}, Noise: {n_noise})', fontweight='bold')\n",
    "axes[1].set_xlabel('PC1')\n",
    "axes[1].set_ylabel('PC2')\n",
    "\n",
    "axes[2].scatter(X_pca_3d[:, 0], X_pca_3d[:, 1], c=labels_hierarchical, cmap='tab10', alpha=0.4, s=15)\n",
    "axes[2].set_title('Hierarchical Ward (K=3)', fontweight='bold')\n",
    "axes[2].set_xlabel('PC1')\n",
    "axes[2].set_ylabel('PC2')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Metric: Within-cluster variance vs Global Variance\n",
    "global_var = np.var(X_scaled, axis=0).sum()\n",
    "\n",
    "def compute_variance_ratio(labels, data):\n",
    "    unique_labels = [l for l in np.unique(labels) if l != -1]\n",
    "    if len(unique_labels) == 0:\n",
    "        return np.nan\n",
    "    cluster_vars = [np.var(data[labels == l], axis=0).sum() for l in unique_labels]\n",
    "    return np.mean(cluster_vars) / global_var\n",
    "\n",
    "def safe_silhouette(data, labels):\n",
    "    # Silhouette requires at least 2 distinct clusters and strictly < n_samples\n",
    "    unique_labels = set(labels) - {-1}\n",
    "    if len(unique_labels) < 2:\n",
    "        return \"N/A (Fewer than 2 valid clusters)\"\n",
    "    valid_mask = labels != -1\n",
    "    return f\"{silhouette_score(data[valid_mask], labels[valid_mask]):.4f}\"\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"CLUSTERING METRIC EVALUATION (Variance Ratio & Silhouette)\")\n",
    "print(\"=\" * 70)\n",
    "print(f\"Global Feature Variance (Scaled): {global_var:.4f}\")\n",
    "print(f\"K-Means Variance Ratio:          {compute_variance_ratio(labels_kmeans, X_scaled):.4f} | Silhouette: {safe_silhouette(X_scaled, labels_kmeans)}\")\n",
    "print(f\"Hierarchical Variance Ratio:     {compute_variance_ratio(labels_hierarchical, X_scaled):.4f} | Silhouette: {safe_silhouette(X_scaled, labels_hierarchical)}\")\n",
    "print(f\"DBSCAN Variance Ratio (Core):    {compute_variance_ratio(labels_dbscan, X_scaled):.4f} | Silhouette: {safe_silhouette(X_scaled, labels_dbscan)}\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# 2. FEATURE SPACE CLUSTERING (Transposed Data Matrix)\n",
    "X_features = X_scaled.T  # Shape: (11 features, N samples)\n",
    "feat_clusterer = AgglomerativeClustering(n_clusters=3, linkage='ward')\n",
    "feature_labels = feat_clusterer.fit_predict(X_features)\n",
    "\n",
    "feature_clusters_df = pd.DataFrame({\n",
    "    'Feature': numerical_features,\n",
    "    'Cluster_Assigned': feature_labels\n",
    "}).sort_values('Cluster_Assigned')\n",
    "\n",
    "print(\"\\n--- FEATURE SPACE CLUSTERING (Clustering Variables directly): ---\")\n",
    "print(feature_clusters_df.to_string(index=False))"
