    "# ==============================================================================\n",
    "# SECTION 6: QUANTITATIVE ANOMALY OVERLAP & AGREEMENT MATRIX\n",
    "# Calculating pairwise Jaccard similarities and cross-method consensus\n",
    "# ==============================================================================\n",
    "\n",
    "# Total counts and consensus\n",
    "consensus_all = (anomaly_results.sum(axis=1) == 3).sum()\n",
    "consensus_any = (anomaly_results.sum(axis=1) >= 1).sum()\n",
    "\n",
    "print(\"=\" * 65)\n",
    "print(\"SECTION 6: ANOMALY DETECTION OVERLAP AND CONSENSUS\")\n",
    "print(\"=\" * 65)\n",
    "print(f\"Total Unique Anomalies Flagged by at least one method: {consensus_any}\")\n",
    "print(f\"Universal Consensus Anomalies (Flagged by ALL 3):      {consensus_all}\")\n",
    "print(\"-\" * 65)\n",
    "\n",
    "# Pairwise Agreement (Jaccard Index)\n",
    "def jaccard(col1, col2):\n",
    "    intersection = np.logical_and(col1, col2).sum()\n",
    "    union = np.logical_or(col1, col2).sum()\n",
    "    return intersection / union\n",
    "\n",
    "methods = ['Z_Score', 'Isolation_Forest', 'LOF']\n",
    "jaccard_matrix = pd.DataFrame(index=methods, columns=methods, dtype=float)\n",
    "\n",
    "for m1 in methods:\n",
    "    for m2 in methods:\n",
    "        jaccard_matrix.loc[m1, m2] = jaccard(anomaly_results[m1], anomaly_results[m2])\n",
    "\n",
    "print(\"Pairwise Jaccard Similarity Matrix Between Anomaly Detectors:\")\n",
    "print(jaccard_matrix.round(3))\n",
    "print(\"=\" * 65)\n",
    "\n",
    "# Visualizing overlap distribution\n",
    "plt.figure(figsize=(7, 4))\n",
