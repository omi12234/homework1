    "# ==============================================================================\n",
    "# SECTION 3: PRINCIPAL COMPONENT ANALYSIS (PCA)\n",
    "# Standardization, Scree plot, 2D/3D Projections, and Component Loadings\n",
    "# ==============================================================================\n",
    "\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.decomposition import PCA\n",
    "from mpl_toolkits.mplot3d import Axes3D\n",
    "\n",
    "# Standardize features (Mean = 0, Variance = 1)\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(df_clean)\n",
    "\n",
    "# Full PCA decomposition\n",
    "pca_full = PCA().fit(X_scaled)\n",
    "exp_var = pca_full.explained_variance_ratio_\n",
    "cum_var = np.cumsum(exp_var)\n",
    "\n",
    "# Scree Plot & Cumulative Explained Variance\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "axes[0].plot(range(1, len(exp_var) + 1), exp_var, 'o-', color='navy', lw=2)\n",
    "axes[0].set_title('Scree Plot (Explained Variance per PC)', fontweight='bold')\n",
    "axes[0].set_xlabel('Principal Component')\n",
    "axes[0].set_ylabel('Explained Variance Ratio')\n",
    "axes[0].grid(True, linestyle=':')\n",
    "\n",
    "axes[1].plot(range(1, len(cum_var) + 1), cum_var, 's-', color='darkred', lw=2)\n",
    "axes[1].axhline(0.80, color='gray', linestyle='--', label='80% Variance Threshold')\n",
    "axes[1].set_title('Cumulative Explained Variance', fontweight='bold')\n",
    "axes[1].set_xlabel('Number of Components')\n",
    "axes[1].set_ylabel('Cumulative Variance Ratio')\n",
    "axes[1].legend()\n",
    "axes[1].grid(True, linestyle=':')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 2D and 3D PCA Projections\n",
    "pca_3d = PCA(n_components=3)\n",
    "X_pca_3d = pca_3d.fit_transform(X_scaled)\n",
    "\n",
    "fig = plt.figure(figsize=(15, 6))\n",
    "\n",
    "# 2D Projection\n",
    "ax1 = fig.add_subplot(1, 2, 1)\n",
    "scatter1 = ax1.scatter(X_pca_3d[:, 0], X_pca_3d[:, 1], c=df_clean['koi_period'], cmap='viridis', alpha=0.4, s=15)\n",
    "ax1.set_title('2D PCA Projection (Colored by Orbital Period)', fontweight='bold')\n",
    "ax1.set_xlabel(f'PC1 ({pca_3d.explained_variance_ratio_[0]*100:.1f}%)')\n",
    "ax1.set_ylabel(f'PC2 ({pca_3d.explained_variance_ratio_[1]*100:.1f}%)')\n",
    "fig.colorbar(scatter1, ax=ax1, label='Orbital Period [days]')\n",
    "\n",
    "# 3D Projection\n",
    "ax2 = fig.add_subplot(1, 2, 2, projection='3d')\n",
    "scatter2 = ax2.scatter(X_pca_3d[:, 0], X_pca_3d[:, 1], X_pca_3d[:, 2], c=df_clean['koi_period'], cmap='viridis', alpha=0.3, s=12)\n",
    "ax2.set_title('3D PCA Projection', fontweight='bold')\n",
    "ax2.set_xlabel('PC1')\n",
    "ax2.set_ylabel('PC2')\n",
    "ax2.set_zlabel('PC3')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Principal Components Loadings (Top contributing features)\n",
