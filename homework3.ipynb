    "# ==============================================================================\n",
    "# SECTION 5: MULTI-DIMENSIONAL ANOMALY DETECTION\n",
    "# Methods: Z-Score, Isolation Forest, and Local Outlier Factor (LOF)\n",
    "# Contamination set to 5% (0.05) across algorithms for fair comparison\n",
    "# ==============================================================================\n",
    "\n",
    "from sklearn.ensemble import IsolationForest\n",
    "from sklearn.neighbors import LocalOutlierFactor\n",
    "\n",
    "contamination_rate = 0.05\n",
    "\n",
    "# 1. Z-Score Method (Global maximum univariate Z-score)\n",
    "z_scores = np.abs(stats.zscore(df_clean))\n",
    "max_z_scores = z_scores.max(axis=1)\n",
    "threshold_z = np.percentile(max_z_scores, 100 * (1 - contamination_rate))\n",
    "anomalies_z = (max_z_scores >= threshold_z).astype(int)\n",
    "\n",
    "# 2. Isolation Forest\n",
    "iso_forest = IsolationForest(contamination=contamination_rate, random_state=42, n_jobs=-1)\n",
    "# 1 = Inlier, -1 = Outlier\n",
    "anomalies_iso = (iso_forest.fit_predict(X_scaled) == -1).astype(int)\n",
    "iso_scores = -iso_forest.score_samples(X_scaled)\n",
    "\n",
    "# 3. Local Outlier Factor (LOF)\n",
    "lof = LocalOutlierFactor(n_neighbors=20, contamination=contamination_rate, n_jobs=-1)\n",
    "anomalies_lof = (lof.fit_predict(X_scaled) == -1).astype(int)\n",
    "lof_scores = -lof.negative_outlier_factor_\n",
    "\n",
    "# Store anomalies in DataFrame\n",
    "anomaly_results = pd.DataFrame({\n",
    "    'Z_Score': anomalies_z,\n",
    "    'Isolation_Forest': anomalies_iso,\n",
    "    'LOF': anomalies_lof\n",
    "})\n",
    "\n",
    "# Visualization on 2D PCA Space\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "\n",
    "axes[0].scatter(X_pca_3d[:, 0], X_pca_3d[:, 1], c=anomalies_z, cmap='coolwarm', alpha=0.4, s=15)\n",
    "axes[0].set_title(f'Z-Score Anomalies (N={anomalies_z.sum()})', fontweight='bold')\n",
    "axes[0].set_xlabel('PC1')\n",
    "axes[0].set_ylabel('PC2')\n",
    "\n",
    "axes[1].scatter(X_pca_3d[:, 0], X_pca_3d[:, 1], c=anomalies_iso, cmap='coolwarm', alpha=0.4, s=15)\n",
    "axes[1].set_title(f'Isolation Forest Anomalies (N={anomalies_iso.sum()})', fontweight='bold')\n",
    "axes[1].set_xlabel('PC1')\n",
    "axes[1].set_ylabel('PC2')\n",
    "\n",
    "axes[2].scatter(X_pca_3d[:, 0], X_pca_3d[:, 1], c=anomalies_lof, cmap='coolwarm', alpha=0.4, s=15)\n",
    "axes[2].set_title(f'LOF Anomalies (N={anomalies_lof.sum()})', fontweight='bold')\n",
    "axes[2].set_xlabel('PC1')\n",
    "axes[2].set_ylabel('PC2')\n",
